# Protected admin routes (§11).
#
# Every .html page in this directory is served by guard.php, which checks the
# session BEFORE reading the file. Without this the pages are plain static
# files and anyone with the URL reads them — which is exactly the hole this
# recovery stage exists to close.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /admin/

  # guard.php itself, and the shared script, are served directly
  RewriteRule ^guard\.php$ - [L]
  RewriteRule ^app\.js$ - [L]

  # /admin/ with no page named
  RewriteRule ^$ guard.php?page=dashboard.html [QSA,L]

  # The clean address is the canonical one. A request that still names the file
  # is answered with a permanent redirect so a bookmark keeps working and only
  # one address is ever indexed or shared. THE_REQUEST is the original request
  # line, so the internal rewrite below cannot re-trigger this and loop.
  RewriteCond %{THE_REQUEST} \s/+admin/([a-z0-9][a-z0-9-]*)\.html[\s?] [NC]
  RewriteRule ^ /admin/%1 [R=301,L]

  # every page goes through the guard, named cleanly or not
  RewriteRule ^([a-z0-9][a-z0-9-]*)\.html$ guard.php?page=$1.html [QSA,L]
  RewriteRule ^([a-z0-9][a-z0-9-]*)$      guard.php?page=$1.html [QSA,L]
</IfModule>

# If mod_rewrite is unavailable the pages would be served raw, which is worse
# than not serving them. Deny by default and let the rewrite above re-open the
# specific paths it handles.
<IfModule !mod_rewrite.c>
  <FilesMatch "\.html$">
    <IfModule mod_authz_core.c>
      Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
      Order deny,allow
      Deny from all
    </IfModule>
  </FilesMatch>
</IfModule>

# Never cache an admin page: a cached page still renders after logout.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js)$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, private"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
  </FilesMatch>

  # The sign-in page has to stay reachable without a session, so it is the one
  # admin page a crawler can actually read — and its address is short and
  # shareable now, which makes it likelier to be pasted somewhere public. An
  # administrative sign-in form in search results is an invitation to try
  # passwords against it. A header rather than a robots.txt Disallow: a header
  # removes a page already indexed and does not publish the path to anyone
  # reading robots.txt.
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
</IfModule>

# The design logs and QA reports are working documents, not part of the app.
<FilesMatch "\.md$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

DirectoryIndex guard.php
