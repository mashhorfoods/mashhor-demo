# عون الدرب للنقل المتخصص — backend configuration
#
# COPY THIS FILE TO .env AND FILL IT IN. NEVER COMMIT .env.
#
# Preferred location on Hostinger: one level ABOVE public_html, i.e.
#   /home/<user>/.env
# The application looks there first. If it is not found, it falls back to
#   public_html/app/.env
# which app/.htaccess denies to the web — but above the web root is stronger,
# because a misconfigured host cannot serve what is not under the document
# root at all. See DEPLOY.md.

# --- application -------------------------------------------------------------
APP_ENV=production          # production | development
APP_DEBUG=false             # true only on a machine nobody else can reach
APP_URL=https://aunaldrb.com

# --- database ----------------------------------------------------------------
# On Hostinger: hPanel → Databases → MySQL Databases. The host is almost always
# localhost; the database name and user both carry the account prefix.
DB_DRIVER=mysql             # mysql | sqlite  (sqlite is for local development)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# sqlite only — path is relative to the project root
DB_SQLITE_PATH=app/storage/aun.sqlite

# --- sessions ----------------------------------------------------------------
# APP_KEY signs nothing on its own but seeds token derivation. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
SESSION_COOKIE=aun_sid
SESSION_IDLE_MINUTES=120        # inactivity before a session is rejected
SESSION_ABSOLUTE_HOURS=12       # hard ceiling regardless of activity
SESSION_COOKIE_SECURE=true      # false ONLY for local http development

# --- public request endpoint -------------------------------------------------
REQUESTS_RATE_PER_HOUR=8        # submissions allowed per IP per hour
REQUESTS_DEDUPE_MINUTES=10      # window in which an identical submission is
                                # treated as a retry rather than a new request
