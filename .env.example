# Number One Travel & Tourism — deployment configuration (Stages 12.1–12.2)
#
# These variables are read ONLY by `node tools/write-env.mjs`, which writes the
# browser's public configuration to assets/js/data/env.js. Every value below is
# therefore PUBLIC: it ships to every visitor. Nothing private belongs here.
#
# Private material (identity-provider secrets, service-role keys, database and
# storage credentials, payment secrets, signing keys) is configured on the
# BACKEND that API_BASE_URL points at — never in this repository, never in the
# browser. The site talks to that backend only, over HTTPS, with cookie sessions.

# development | staging | production. Production refuses AUTH_PROVIDER=dev and
# requires an https API_BASE_URL — a production build cannot use mock data.
NO_ENVIRONMENT=development

# dev          — the in-browser development adapters (never in production)
# session-api  — the backend's session endpoints (see docs/INTEGRATION.md §Contract)
AUTH_PROVIDER=dev

# Browser-safe identity settings only. Example: {"sessionRefreshMinutes":10}
AUTH_PUBLIC_CONFIG={"sessionRefreshMinutes":10}

# The customer backend origin (+ path). Empty in development. The backend must
# allow this site's origin with credentials (CORS) and set HttpOnly session cookies.
API_BASE_URL=

# Upload limits the backend enforces too. Example: {"maxBytes":5242880,"accept":["application/pdf","image/jpeg","image/png"]}
DOCUMENT_SERVICE_CONFIG={"maxBytes":5242880,"accept":["application/pdf","image/jpeg","image/png"]}

# Payment-history page size. Example: {"pageSize":20}
PAYMENT_API_CONFIG={"pageSize":20}

# In-app notification refresh. Example: {"refreshOnFocus":true,"refreshMinSeconds":30}
NOTIFICATION_CONFIG={"refreshOnFocus":true,"refreshMinSeconds":30}

# Where the Terms of Service and Privacy Policy come from:
#   {"source":"api"}                                   — GET {API_BASE_URL}/legal/terms|privacy?locale=
#   {"source":"static","termsPath":"legal/terms.{locale}.html","privacyPath":"legal/privacy.{locale}.html"}
#   {"source":null}                                    — not supplied yet: the pages say so, nothing is invented
LEGAL_DOCUMENT_CONFIG={"source":null}

# Optional beacon endpoint on the same backend for safe technical events. Example: {"endpoint":"/diagnostics"}
DIAGNOSTICS_CONFIG={"endpoint":null}

# INTEGRATIONS_VERIFIED is NOT set by hand. tools/deploy.mjs writes it (with
# --verified-by-deploy) after the smoke and acceptance suites pass against the
# deployed backend; it is what makes the adapter registry read CONNECTED.
# The backend's own variables (BACKEND_*) live on the server: backend/.env.example.
