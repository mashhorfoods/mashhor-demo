# Every /api/* URL is answered by index.php. Without this the server would look
# for a file called "requests" in this directory and return 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /api/

  # a real file (there is only index.php) is served as itself
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  RewriteRule ^ index.php [QSA,L]
</IfModule>

# The API is never cached — a stale 401 or a stale request list is worse than
# a round trip.
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store, private"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

# The site's root .htaccess forces index.html as the directory index; inside
# api/ that would 404, so name the right one here.
DirectoryIndex index.php
