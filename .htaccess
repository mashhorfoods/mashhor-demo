# عون الدرب للنقل المتخصص — Apache configuration for the uploaded site
# STAGE M13 §28/§29/§46
#
# This site is static: no runtime, no database, no build server. Three things
# still have to be configured, and leaving them to the host is the difference
# between a mobile Lighthouse performance score of 99 and one of 93 — measured
# on this exact build, with the whole difference in LCP (2.2s against 3.1s).
#
# On Apache with AllowOverride enabled this file does all three by itself. On
# Nginx it is inert; DEPLOY.md carries the equivalent server block.
#
# Every directive is wrapped in <IfModule> so a host without the module gets a
# working site rather than a 500.

# --- 1 · which file answers "/" ----------------------------------------------
# Named explicitly, because the default order on most shared hosts puts
# index.php ahead of index.html — and shared hosts hand you a public_html with
# a placeholder default.php or index.php already in it. Delete the placeholder,
# but do not rely on having remembered to: this makes index.html the answer
# either way.
DirectoryIndex index.html

# --- 2 · not-found -----------------------------------------------------------
ErrorDocument 404 /404.html

# There is no index file in img/, fonts/ or brand/, and without this the server
# offers a browsable listing of them instead of a 404. Nothing in there is
# secret; a file index is simply not part of the site.
<IfModule mod_autoindex.c>
  IndexIgnore *
</IfModule>

# --- 3 · one canonical address ----------------------------------------------
# The <link rel="canonical">, the sitemap, the Open Graph tags and the JSON-LD
# all name exactly one address: https://aunaldrb.com/ . Without the two rules
# below the server also answers on http:// and on www., which is the same page
# at three URLs — a crawler has to guess which one is the real one, and the
# link equity of the other two is spent on guessing.
#
# Neither rule names a domain. They send www to the apex and http to https on
# WHATEVER host was asked for, which means this file is identical on a staging
# domain and on the real one — nothing to remember to change at cutover, and
# no chance of a staging request being 301'd onto the production site. Section
# 3b below is what keeps the two apart for crawlers.
#
# THESE ASSUME A TLS CERTIFICATE IS INSTALLED AND COVERS BOTH THE APEX AND www.
# It is a requirement of this site either way (see "Server requirements" in
# DEPLOY.md), but if the certificate is not in place yet, comment this block
# out until it is — redirecting to an address that cannot be served takes the
# site down.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www -> apex first, so a request to http://www. reaches its final address in
  # one redirect rather than two.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # http -> https. X-Forwarded-Proto covers hosts that terminate TLS upstream.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# --- 3b · only the real domain may be indexed -------------------------------
# While the site is being verified it is served from a temporary domain. Every
# canonical URL, Open Graph tag and JSON-LD node in index.html names
# aunaldrb.com, so a crawler that found the temporary copy would index a page
# claiming to be somewhere else — duplicate content, pointing at a site that is
# not live yet.
#
# The rule is stated as "the canonical host is allowed, everything else is
# not", so it needs no attention at cutover: the header disappears by itself
# the moment the real domain serves the page, and reappears if the site is ever
# staged again. robots.txt deliberately allows crawling, so a crawler does
# fetch the page — and this header is what it reads when it does.
<IfModule mod_headers.c>
  SetEnvIf Host "^(www\.)?aunaldrb\.com$" AUN_CANONICAL_HOST=1
  Header always set X-Robots-Tag "noindex, nofollow" env=!AUN_CANONICAL_HOST
</IfModule>

# --- 4 · compression ---------------------------------------------------------
# index.html is 182KB of markup and inline CSS, which gzips to 34KB. It is the
# one render-blocking resource on the page, so this is the single highest-value
# line in the file. Images and fonts are already compressed formats and are
# deliberately not re-compressed.
# On LiteSpeed — which is what Hostinger and most cPanel hosts actually run —
# mod_deflate is not present, so this block is skipped and LiteSpeed's own
# gzip/brotli does the work instead. That is on by default there. The block
# stays for real Apache, where nothing else would compress the page.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS application/xml application/xhtml+xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# --- 5 · caching -------------------------------------------------------------
# The photographs and the fonts carry their width or their weight in the
# filename, so a changed file is a changed name and a year is safe. index.html
# is not versioned and must revalidate, or an update never reaches anyone.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType text/html               "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|avif|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # the fonts are same-origin, but a CDN in front of the site may not be
  <FilesMatch "\.woff2$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  # safe, uncontroversial hardening for a site with no forms, no cookies and
  # no third-party requests at all
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  # the admin pages already send this; the public page had no reason to be
  # framed either, and refusing costs nothing
  Header set X-Frame-Options "SAMEORIGIN"
  # nothing on this page uses a camera, a microphone or a location, and the
  # analytics script has no business asking for one either
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
</IfModule>

# --- 5c · content security policy (STAGE 6C) --------------------------------
# What this buys: if anything ever manages to write markup into this page — a
# stored value that reaches the HTML unescaped, a compromised asset — the
# browser still refuses to run it. Without a policy, injected script runs with
# the page's full authority; with one, only the exact scripts this build ships
# are allowed to execute, by hash.
#
# THE HASHES ARE GENERATED, NOT MAINTAINED. build.js reads dist/index.html,
# takes the SHA-256 of every inline script it actually contains, and writes
# them into the copy of this file that ships. The token below is what it
# replaces; a build that cannot find it, or that finds a script it has no hash
# for, fails rather than shipping a policy that would silently break the page.
# That is deliberate: a CSP failure is invisible — no error, no warning, just
# a page whose scripts stopped running — so it has to be caught at build time.
#
# Why each source is here:
#   script-src   'self' for nothing today (every script is inline), the
#                hashes for the four inline blocks, and googletagmanager.com
#                for the analytics tag the page already loads.
#   style-src    'unsafe-inline' because the whole stylesheet is inline. A
#                style injection cannot execute; a script injection can, and
#                that is the one this policy is written to stop.
#   img-src      data: for the inlined SVG icons, and Google's two hosts for
#                the analytics beacon.
#   connect-src  where the analytics tag reports to, and nowhere else.
#   frame-src / object-src  'none': this page embeds nothing.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com __AUN_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.googletagmanager.com https://www.google-analytics.com; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; frame-src 'none'; object-src 'none'"
  </FilesMatch>
</IfModule>

# --- 5d · HSTS, on the real domain only (STAGE 6C) ---------------------------
# Tells the browser to refuse plain http for this host for a year, so a visitor
# who types the address is never sent over an interceptable connection at all —
# the redirect in section 3 only helps after the first request has already
# travelled in the clear.
#
# It reuses section 3b's AUN_CANONICAL_HOST, so it applies to aunaldrb.com and
# to nothing else. That matters more than it looks: HSTS is remembered by the
# browser and cannot be withdrawn early, so sending it from a temporary domain
# would pin a host that is not ours and is not staying.
#
# includeSubDomains is set because every subdomain of aunaldrb.com is ours and
# serves over TLS. `preload` is deliberately NOT set: submitting to the preload
# list is effectively permanent and is a decision to take on purpose, not a
# side effect of a deployment.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=AUN_CANONICAL_HOST
</IfModule>

# --- 5b · never serve configuration or source (RECOVERY 01 §22/§23) ----------
# The application lives in app/, which has its own "deny all". These rules are
# the second lock, at the document root, for the case where a host ignores a
# nested .htaccess: nothing that could carry a credential, a schema or a stack
# trace is servable from anywhere under public_html.
<FilesMatch "^\.env|\.(env|ini|log|sqlite|sqlite3|db|md|yml|yaml|lock|json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
# ...except the two JSON documents the public site legitimately serves.
<FilesMatch "^(manifest|site)\.webmanifest$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>

# PHP is executed, never listed: the whole app/ tree and the two CLI scripts
# are off limits over HTTP. api/index.php and admin/guard.php are the only
# entry points, and each lives behind its own directory's rules.
RedirectMatch 404 ^/(app|bin)/
RedirectMatch 404 ^/\.git

# --- 6 · correct types -------------------------------------------------------
# some shared hosts still do not know AVIF or WOFF2, and serve them as
# application/octet-stream, which the browser will not decode
<IfModule mod_mime.c>
  AddType image/avif  .avif
  AddType image/webp  .webp
  AddType font/woff2  .woff2
</IfModule>
