# ============================================================================
# Number One Travel & Tourism — customer backend configuration (backend/)
#
# Copy to backend/.env on the SERVER only (backend/.env is git-ignored) or set
# these in the hosting platform's secret store. Nothing in this file is ever
# read by the browser; the website's public configuration is the repository
# root .env.example → tools/write-env.mjs. Values below are examples, not real.
# Production refuses to start on an unsafe combination (backend/config.mjs).
# ============================================================================

# development | staging | production
BACKEND_ENV=development

# Listen address. Behind a reverse proxy / container, bind 0.0.0.0.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8930

# The https origin this backend is served from (production: required, https).
# Signed document links are issued on this origin.
BACKEND_PUBLIC_URL=

# Exact website origins allowed with credentials (comma-separated, never *).
# Production: https only. Example: https://www.example.com
BACKEND_ALLOWED_ORIGINS=

# 32+ random characters (openssl rand -hex 32). Signs document links and is
# required in staging and production. Rotating it invalidates issued links only.
BACKEND_SIGNING_SECRET=

# SQLite database file (node:sqlite, WAL). Point at persistent storage.
BACKEND_DATABASE_PATH=./data/numberone.sqlite

# Session cookie (HttpOnly). Production requires Secure=1.
# SameSite: Lax (site and backend under one registrable domain) | Strict | None (requires Secure)
BACKEND_COOKIE_SECURE=0
BACKEND_COOKIE_SAMESITE=Lax
BACKEND_COOKIE_DOMAIN=
BACKEND_SESSION_TTL_HOURS=12
BACKEND_RESET_TTL_MINUTES=30

# Abuse protection — defaults need business approval (docs/INTEGRATION.md §9)
BACKEND_LOCKOUT_ATTEMPTS=10
BACKEND_LOCKOUT_MINUTES=15
BACKEND_PASSWORD_MIN_LENGTH=8
BACKEND_RATE_AUTH=10
BACKEND_RATE_UPLOAD=20
BACKEND_RATE_API=300

# Private document storage. Implemented: local (a directory outside any web
# root). s3 is a documented seam, not implemented — the value is refused.
BACKEND_STORAGE=local
BACKEND_STORAGE_DIR=./data/documents
BACKEND_UPLOAD_MAX_BYTES=5242880
BACKEND_UPLOAD_TYPES=application/pdf,image/jpeg,image/png
BACKEND_SIGNED_URL_TTL_SECONDS=300

# Email / SMS delivery. Implemented: none (deliveries are recorded in the
# outbox as queued and NEVER reported as sent). A provider is a new mailer
# module plus its credentials here — not before it is tested end to end.
BACKEND_MAILER=none

# Official legal documents supplied by the business (never written here):
# <dir>/terms.ar.html terms.en.html privacy.ar.html privacy.en.html meta.json
BACKEND_LEGAL_DIR=./legal

# Supervisor ids the attribution links may carry (backend-authoritative list).
BACKEND_SUPERVISORS=supervisor-1,supervisor-2,supervisor-3,supervisor-4,supervisor-5

# Stage 13 — the ONE entry point prepared for the future Admin Dashboard
# (reassigning a customer's attribution). Leave empty to disable it entirely
# (the route then answers 404). When set, it must be a real secret, 32+
# random characters (openssl rand -hex 32) sent as `Authorization: Bearer
# <token>` — there is no admin UI yet, so nothing else can use this.
BACKEND_ADMIN_TOKEN=

# 1 when a trusted reverse proxy sets X-Forwarded-For (rate limiting by client ip).
BACKEND_TRUST_PROXY=0

# Test controls (/__test/*) for the acceptance suite — staging only; production refuses 1.
BACKEND_TEST_CONTROLS=0
