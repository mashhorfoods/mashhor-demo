node_modules/

# package.json IS tracked from M13: tools-images.js needs sharp, and a build
# tool whose dependency is not written down is a build tool that stops working.
# The lockfile is not — there is nothing at runtime to pin, and the two build
# scripts are the only consumers.
package-lock.json
aun-aldrb-site.zip
local-preview.html

# The deployable site, assembled by build.js from the sources beside it. Derived,
# not source — 156 files and 7.6MB of it, 143 byte-identical to the file it was
# copied from, so committing it stored every image and font twice and made every
# build a diff. `node build.js` regenerates it, and bin/release.php now does that
# itself before the three gates that read it. What gets uploaded is the zip
# tools-package.js writes from it, which was never committed either.
dist/

# Generated by tools-images.js from the masters in img/. Derived, not source —
# regenerate with `node tools-images.js`. What actually ships is in dist/img/.
img/*-[0-9]*.webp
img/*-[0-9]*.avif
img/manifest.json

# --- backend (RECOVERY 01) ---------------------------------------------------
# Real configuration never enters the repository. .env.example carries the
# shape; .env carries the credentials and stays on the server.
.env
.env.*
!.env.example

# Runtime state: the SQLite database used for local development and the
# verification suite, and the application log.
app/storage/*.sqlite
app/storage/*.sqlite-*
app/storage/logs/*.log
app/storage/backups/
app/storage/recovery-attempts.json
app/storage/.last-prune
app/storage/logs/.last-sweep
.build-stamp.json
