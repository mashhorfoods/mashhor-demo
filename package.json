{
  "name": "travel-demo-site",
  "private": true,
  "description": "السفر والسياحة — Travel & Tourism. Static site: no build step; the tooling below is for verification and content only.",
  "type": "module",
  "scripts": {
    "test": "node tests/run.mjs",
    "test:backend": "node tests/run-backend.mjs",
    "audit": "node tests/run.mjs --audits",
    "backend:start": "npm --prefix backend start",
    "backend:migrate": "npm --prefix backend run migrate",
    "backend:check": "npm --prefix backend run check",
    "smoke": "node tools/smoke.mjs",
    "deploy": "node tools/deploy.mjs",
    "routes": "node tools/build-routes.mjs",
    "serve": "node tools/serve.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
